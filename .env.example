# Copy to .env for local development. Never commit .env.

# --- Local PostgreSQL (compose.yml) ---
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_DB=saas
POSTGRES_OWNER_PASSWORD=saas_owner
POSTGRES_APP_PASSWORD=saas_app
# Host ports, change if something else already uses them.
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- API ---
# Runtime connection: the app role, subject to row-level security (ADR 0008).
DATABASE_URL=postgres://saas_app:saas_app@localhost:5432/saas?sslmode=disable
# Migrations and seeding: the owner role.
MIGRATION_DATABASE_URL=postgres://saas_owner:saas_owner@localhost:5432/saas?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
# Public URL of the web app; used to build invitation and password reset links.
APP_BASE_URL=http://localhost:3000

# Email (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=go-next-saas <no-reply@go-next-saas.local>

# Production bootstrap (ADR 0012): first organization and owner, created once if missing.
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_SLUG=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_PASSWORD=

# OpenTelemetry: leave empty to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Web ---
# Where the Next.js server reaches the API (server rendering and the dev /api rewrite).
API_INTERNAL_URL=http://localhost:8080
