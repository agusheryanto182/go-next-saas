# Copy to .env for local development. Never commit .env.

# --- Local PostgreSQL (compose.yml) ---
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_DB=saas
POSTGRES_OWNER_PASSWORD=saas_owner
POSTGRES_APP_PASSWORD=saas_app
# Host ports, change if something else already uses them.
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- API ---
# Runtime connection: the app role, subject to row-level security (ADR 0008). Also used by
# `app seed` and `app create-org` (ADR 0012).
DATABASE_URL=postgres://saas_app:saas_app@localhost:5432/saas?sslmode=disable
# Migrations only: the owner role.
MIGRATION_DATABASE_URL=postgres://saas_owner:saas_owner@localhost:5432/saas?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
# Public URL of the web app; used to build invitation and password reset links.
APP_BASE_URL=http://localhost:3000

# Email (ADR 0010). Mailpit locally; production providers usually take starttls on port 587.
SMTP_HOST=localhost
SMTP_PORT=1025
# Set both or neither; empty means no authentication.
SMTP_USERNAME=
SMTP_PASSWORD=
# none | starttls | tls (implicit TLS, usually port 465). Default starttls.
SMTP_TLS=none
# Bounds for connecting to the server and for one whole delivery (at most 20s: see ADR 0010).
SMTP_CONNECT_TIMEOUT=10s
SMTP_SEND_TIMEOUT=15s
# Sender of every email; the domain is also used in Message-IDs.
MAIL_FROM="go-next-saas <no-reply@go-next-saas.local>"

# OpenTelemetry: leave empty to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Web ---
# Where the Next.js server reaches the API (server rendering and the dev /api rewrite).
API_INTERNAL_URL=http://localhost:8080
